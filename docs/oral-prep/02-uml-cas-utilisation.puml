@startuml Mes_Orchidees_UseCase
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFDE7
  BorderColor #F9A825
}
skinparam arrowColor #555555
left to right direction

' ═══════════════════════════════════════════════════════════════════════
' ACTEURS
' ═══════════════════════════════════════════════════════════════════════
actor "Visiteur"              as V
actor "Utilisateur\nconnecté" as U
actor "Administrateur /\nModérateur" as A

' Généralisation : U hérite de V (flèche vide pointillée, convention UML)
U ..|> V

' ═══════════════════════════════════════════════════════════════════════
' PAQUET « CONSUTLER » — accessible sans authentification
' ═══════════════════════════════════════════════════════════════════════
package "Consulter" {
  usecase "UC01\nConsulter l'accueil"      as UC01
  usecase "UC02\nRechercher une orchidée"  as UC02
  usecase "UC03\nConsulter l'encyclopédie" as UC03
  usecase "UC04\nVoir une fiche orchidée"  as UC04
  usecase "UC05\nConsulter les conseils"   as UC05
}

V -- UC01
V -- UC02
V -- UC03
V -- UC04
V -- UC05

' ═══════════════════════════════════════════════════════════════════════
' PAQUET « AUTHENTIFICATION »
' ═══════════════════════════════════════════════════════════════════════
package "Authentification" {
  usecase "UC10\nS'inscrire"     as UC10
  usecase "UC11\nSe connecter"   as UC11
  usecase "UC12\nSe déconnecter" as UC12
}

V -- UC10
V -- UC11
U -- UC12

' ═══════════════════════════════════════════════════════════════════════
' PAQUET « GÉRER MA COLLECTION » — réservé aux utilisateurs connectés
' ═══════════════════════════════════════════════════════════════════════
package "Gérer ma collection" {
  usecase "UC13\nAjouter une plante"            as UC13
  usecase "UC14\nConsulter ma collection"       as UC14
  usecase "UC15\nModifier une plante"           as UC15
  usecase "UC16\nRetirer une plante"            as UC16
  usecase "UC17\nEnregistrer un soin"           as UC17
  usecase "UC18\nConsulter l'historique\nsoins" as UC18
  usecase "UC19\nGérer mes rappels"             as UC19
  usecase "UC20\nConsulter mes\nnotifications"  as UC20
  usecase "UC21\nProposer une\norchidée"        as UC21
}

U -- UC13
U -- UC14
U -- UC15
U -- UC16
U -- UC17
U -- UC18
U -- UC19
U -- UC20
U -- UC21

' ═══════════════════════════════════════════════════════════════════════
' PAQUET « ADMINISTRER » — rôle admin ou modérateur
' ═══════════════════════════════════════════════════════════════════════
package "Administrer" {
  usecase "UC30\nTableau de bord\nadmin"          as UC30
  usecase "UC31\nGérer les\nutilisateurs"         as UC31
  usecase "UC32\nValider / rejeter\nproposition"  as UC32
  usecase "UC33\nGérer les conseils\n(CRUD)"      as UC33
}

A -- UC30
A -- UC31
A -- UC32
A -- UC33

' ═══════════════════════════════════════════════════════════════════════
' RELATIONS <<include>> — sous-cas toujours exécutés (flèche pointillée)
' ═══════════════════════════════════════════════════════════════════════
UC17 ..> UC19 : <<include>>
UC13 ..> UC11 : <<include>>
UC30 ..> UC11 : <<include>>

' ═══════════════════════════════════════════════════════════════════════
' RELATIONS <<extend>> — options conditionnelles
' Positionnées à droite pour éviter tout croisement
' ═══════════════════════════════════════════════════════════════════════
usecase "Désactiver le\nrappel automatique"  as EXT01
UC19 ..> EXT01 : <<extend>>

usecase "Recherche\nFULLTEXT"                as EXT02
UC02 ..> EXT02 : <<extend>>

UC32 ..> UC21 : <<extend>>

' ═══════════════════════════════════════════════════════════════════════
' NOTE : les lignes acteur↔CU sont des traits simples (convention UML).
' Les include/extend sont en pointillés orientés vers le cas cible.
' @generated 2026-10-22 · version 2.0 · corrigé pour 3e oral DWWM
' ═══════════════════════════════════════════════════════════════════════
@enduml
