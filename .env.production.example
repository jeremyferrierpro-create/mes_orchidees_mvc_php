# ==============================================================================
# MES ORCHIDEES — GABARIT DE CONFIGURATION PRODUCTION / PRÉPRODUCTION (Render)
# ==============================================================================
# BUT : documenter TOUTES les variables d'environnement attendues par l'app en
# production. Copier ce fichier dans le tableau de bord Render (Environment) —
# NE JAMAIS le commiter avec de vraies valeurs ni l'embarquer dans l'image
# (le Dockerfile supprime .env* au build ; les secrets viennent du runtime).
#
# Lecture par config/env.php + getenv() : les variables injectées par Render
# ($_ENV / getenv) priment sur tout fichier .env absent.
#
# VARIABLES RÉELLEMENT LUES PAR LE CODE ACTUEL (contrôle Phase 04B) :
#   public/index.php : APP_DEBUG, COOKIE_SECURE, COOKIE_SAMESITE, COOKIE_DOMAIN, APP_BASE_PATH
#   config/db.php    : DB_DSN  OU  DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASS
# Les clés APP_ENV, DB_CHARSET et APP_SECRET sont CONSERVÉES PAR CONVENTION mais
# ne sont PAS encore consommées par le code : à ne pas considérer comme actives.
# ==============================================================================

# --- Environnement applicatif -------------------------------------------------
# production coupe l'affichage des stack traces (voir public/index.php).
APP_ENV=production
APP_DEBUG=false

# --- Base de données MySQL / MariaDB -----------------------------------------
# MODE RECOMMANDÉ (Render) : Render ne fournit PAS de MySQL managé (PostgreSQL
# seulement). Utiliser un MySQL/MariaDB externe (PlanetScale, JAWSDB, ClearDB,
# Railway, ou un VPS). Deux styles acceptés par config/db.php :
#
# (A) DSN complet — prioritaire s'il est défini :
#     format mysql:host=...;port=...;dbname=...;charset=utf8mb4
DB_DSN=mysql:host=YOUR_MYSQL_HOST;port=3306;dbname=mes_orchidees;charset=utf8mb4
#
# (B) Variables discrètes (utilisées si DB_DSN est vide) :
# DB_HOST=YOUR_MYSQL_HOST
# DB_PORT=3306
# DB_NAME=mes_orchidees
# DB_USER=YOUR_MYSQL_USER
# DB_PASS=YOUR_MYSQL_PASSWORD
DB_CHARSET=utf8mb4

# Identifiants quand le mode (A) DB_DSN n'est pas utilisé :
DB_USER=YOUR_MYSQL_USER
DB_PASS=YOUR_MYSQL_PASSWORD

# --- Sécurité des cookies de session (durcissement production) ---------------
# COOKIE_SECURE=true OBLIGATOIRE en production (site servi en HTTPS sur Render) :
# le cookie de session n'est émis que sur TLS, il n'est jamais transmis en clair.
COOKIE_SECURE=true
# SameSite : Lax autorise le retour après redirection externe tout en bloquant
# les requêtes cross-site (protection CSRF navigationnelle). 'Strict' est plus
# stricte mais peut casser des flux de redirection ; 'None' exige COOKIE_SECURE.
COOKIE_SAMESITE=Lax
# COOKIE_DOMAIN : laisser vide pour un cookie rattaché au domaine de Render
# (*.onrender.com). Ne renseigner que pour un domaine personnalisé.
COOKIE_DOMAIN=

# --- Chemin de base (sous-dossier éventuel) ----------------------------------
# Laisser vide si l'app est servie à la racine du domaine (cas Render standard).
# Renseigner uniquement en cas de sous-répertoire (ex : /mes-orchidees).
APP_BASE_PATH=

# --- Clé secrète --------------------------------------------------------------
# 64 caractères aléatoires. Générer : php -r "echo bin2hex(random_bytes(32));"
# Ne jamais réutiliser la valeur de développement.
APP_SECRET=REMPLACER_PAR_64_CARACTERES_ALEATOIRES
