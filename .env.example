# ==============================================================================
# CONFIGURATION DE L'APPLICATION — MES ORCHIDÉES (DWWM)
# ==============================================================================
# Ce fichier sert d'exemple. NE PAS Y METTRE VOS MOTS DE PASSE RÉELS.
# Copiez ce fichier sous le nom '.env' et ajustez vos paramètres locaux.
# ==============================================================================

# Environnement d'exécution (development / production)
APP_ENV=development
APP_DEBUG=true

# Configuration de la base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mes_orchidees
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Sécurité (clé secrète pour les sessions et tokens CSRF)
APP_SECRET=changer_cette_cle_secrete_en_production_64_caracteres
