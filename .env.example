# ==============================================================================
# CONFIGURATION DE L'APPLICATION — MES ORCHIDÉES (DWWM)
# ==============================================================================
# Ce fichier sert d'exemple. NE PAS Y METTRE VOS MOTS DE PASSE RÉELS.
# Copiez ce fichier sous le nom '.env' et ajustez vos paramètres locaux.
# ==============================================================================

# Environnement d'exécution (development / production)
APP_ENV=development
APP_DEBUG=true

# Configuration de la base de données MySQL
# Le code (config/db.php) accepte DB_PASS (nom canonique) ou DB_PASSWORD (alias).
# DB_PASS prime si les deux sont définis. Les deux fonctionnent indépendamment.
DB_HOST=<hote-de-votre-mysql>
DB_PORT=3306
DB_NAME=<nom-de-votre-base>
DB_USER=<utilisateur-mysql>
DB_PASSWORD=<mot-de-passe-mysql>
DB_CHARSET=utf8mb4

# Sécurité (clé secrète pour les sessions et tokens CSRF)
# Générer : php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=<64_caracteres_aleatoires>
