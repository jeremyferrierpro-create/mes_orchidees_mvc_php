{
    "name": "mes-orchidees/app",
    "description": "MES ORCHIDEES - Encyclopedie botanique et gestion de collection. Application PHP MVC (DWWM fil rouge).",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Jeremy Ferrier"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Mithridatem\\Routing\\": "lib/Mithridatem/Router/src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "serve": "php -S localhost:8000 -t public public/index.php",
        "post-autoload-dump": []
    }
}
